@page "/orderdetails/delete"
@using Microsoft.EntityFrameworkCore
@using FullSD_InventoryManagement.Domain
@inject IDbContextFactory<FullSD_InventoryManagement.Data.FullSD_InventoryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>OrderDetail</h2>
    <hr />
    @if (orderdetail is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">OrderID</dt>
            <dd class="col-sm-10">@orderdetail.OrderID</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ItemID</dt>
            <dd class="col-sm-10">@orderdetail.ItemID</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Quantity</dt>
            <dd class="col-sm-10">@orderdetail.Quantity</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@orderdetail.DateCreated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@orderdetail.DateUpdated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@orderdetail.CreatedBy</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@orderdetail.UpdatedBy</dd>
        </dl>
        <EditForm method="post" Model="orderdetail" OnValidSubmit="DeleteOrderDetail" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(orderdetail is null)">Delete</button> |
            <a href="/orderdetails">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private OrderDetail? orderdetail;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        orderdetail = await context.OrderDetail.FirstOrDefaultAsync(m => m.Id == Id);

        if (orderdetail is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteOrderDetail()
    {
        using var context = DbFactory.CreateDbContext();
        context.OrderDetail.Remove(orderdetail!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/orderdetails");
    }
}
