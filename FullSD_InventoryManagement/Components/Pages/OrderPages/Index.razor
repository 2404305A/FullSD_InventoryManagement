@page "/orders"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using FullSD_InventoryManagement.Domain
@using FullSD_InventoryManagement.Data
@implements IAsyncDisposable
@inject IDbContextFactory<FullSD_InventoryManagement.Data.FullSD_InventoryManagementContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<FullSD_InventoryManagementUser> UserManager

@attribute [Authorize(Roles = "Administrator, User")]

<PageTitle>Order History</PageTitle>

<style>
    .dashboard-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 20px;
        background-color: #f9f9f9;
        min-height: calc(100vh - 70px);
    }

    .welcome-text {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 40px;
    }

    .tab-container {
        display: flex;
        gap: 30px;
        width: 100%;
        max-width: 1100px;
        margin-bottom: 10px;
        padding-left: 10px;
    }

    .tab {
        font-weight: 600;
        color: #666;
        text-decoration: none;
        padding-bottom: 5px;
        cursor: pointer;
    }

        .tab.active {
            color: black;
            border-bottom: 2px solid black;
        }

    .inventory-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 1100px;
        border: 1px solid #e0e0e0;
    }

    .table-header {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-create {
        background-color: black;
        color: white;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
    }

        .btn-create:hover {
            background-color: #333;
            color: white;
        }

    /* Grid Styles */
    ::deep .quickgrid-table {
        width: 100%;
        border-collapse: collapse;
    }

        ::deep .quickgrid-table th {
            background-color: #f8f9fa;
            color: #888;
            font-weight: 600;
            text-align: left;
            padding: 12px;
            border-bottom: 2px solid #eee;
        }

        ::deep .quickgrid-table td {
            padding: 12px;
            border-bottom: 1px solid #f5f5f5;
            vertical-align: middle;
        }
</style>

<div class="dashboard-container">
    <h1 class="welcome-text">Welcome, @(displayUserName ?? "User")</h1>

    @* Navigation Tabs *@
    <div class="tab-container">
        <a href="/inventory" class="tab">Inventory</a>
        <a href="/orders" class="tab active">Order History</a>

        @if (isAdmin)
        {
            <a href="/orders/pending" class="tab">Pending Approvals</a>
        }
    </div>

    <div class="inventory-card">
        <div class="table-header">
            <span>Order History</span>
            <a href="orders/create" class="btn-create">+ Create New Order</a>
        </div>

        @if (FilteredOrders != null)
        {
            <QuickGrid Class="quickgrid-table" Items="FilteredOrders">
                <PropertyColumn Property="order => order.Id" Title="ID" Sortable="true" />

                <TemplateColumn Title="Status" Sortable="true">
                    @switch (context.Status)
                    {
                        case OrderStatus.Approved:
                            <span class="badge bg-success">Approved</span>
                            break;
                        case OrderStatus.Denied:
                            <span class="badge bg-danger">Denied</span>
                            break;
                        default:
                            <span class="badge bg-warning text-dark">Pending</span>
                            break;
                    }
                </TemplateColumn>

                <PropertyColumn Property="order => order.Movement" Sortable="true" />
                <PropertyColumn Property="order => order.Location" Title="Branch/Loc" Sortable="true" />

                <TemplateColumn Title="Items">
                    @if (context.OrderDetails.Any())
                    {
                        <ul class="list-unstyled m-0 small">
                            @foreach (var detail in context.OrderDetails)
                            {
                                <li>
                                    <strong>@(detail.Item?.Name ?? "Unknown")</strong>: @detail.Quantity
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </TemplateColumn>

                <PropertyColumn Property="order => order.DateCreated" Title="Date" Format="MMM dd, yyyy" Sortable="true" />
                <PropertyColumn Property="order => order.CreatedBy" Title="User" Sortable="true" />

                <TemplateColumn Title="Actions">
                    <a href="@($"orders/details?id={context.Id}")" class="text-decoration-none fw-bold text-dark">Details</a>
                    @if (isAdmin)
                    {
                        <span class="mx-1">|</span>
                        <a href="@($"orders/delete?id={context.Id}")" class="text-danger text-decoration-none">Delete</a>
                    }
                </TemplateColumn>
            </QuickGrid>
        }
        else
        {
            <p>Loading orders...</p>
        }
    </div>
</div>

@code {
    private FullSD_InventoryManagementContext context = default!;
    private IQueryable<Order>? FilteredOrders;

    private bool isAdmin = false;
    private string? displayUserName;

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;
        isAdmin = userPrincipal.IsInRole("Administrator");
        var userName = userPrincipal.Identity?.Name;

        var identityUser = await UserManager.GetUserAsync(userPrincipal);
        displayUserName = (!string.IsNullOrEmpty(identityUser?.FirstName)) ? identityUser.FirstName : userName;

        if (isAdmin)
        {
            FilteredOrders = context.Order
                .Include(o => o.OrderDetails)
                .ThenInclude(od => od.Item)
                .OrderByDescending(o => o.DateCreated);
        }
        else
        {
            var domainUser = await context.User
                .FirstOrDefaultAsync(u => u.EmailAddress == userName || u.Username == userName);

            if (domainUser != null)
            {
                FilteredOrders = context.Order
                    .Where(o => o.BranchID == domainUser.BranchID)
                    .Include(o => o.OrderDetails)
                    .ThenInclude(od => od.Item)
                    .OrderByDescending(o => o.DateCreated);
            }
            else
            {
                FilteredOrders = Enumerable.Empty<Order>().AsQueryable();
            }
        }
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}