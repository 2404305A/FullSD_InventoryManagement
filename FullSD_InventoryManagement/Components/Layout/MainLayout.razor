@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <main>
        @* Nav Bar matches your darkgrey header style *@
        <div class="top-row" style="display: flex; justify-content: space-between; align-items: center; height: 70px; padding: 0 80px; background-color: darkgrey; border-bottom: 1px solid #eee; width: 100%;">

            @* Logo Section *@
            <div style="display: flex; align-items: center; gap: 10px; font-weight: bold; cursor: pointer;" @onclick='() => Navigation.NavigateTo("/")'>
                <span style="font-size: 1.2rem;">❈ GoInventory</span>
            </div>

            @* Links and Auth Section *@
            <div style="display: flex; align-items: center; gap: 30px;">
                <a href="about" style="text-decoration: none; color: steelblue; font-weight: bold;">About</a>
                <a href="contact" style="text-decoration: none; color: steelblue; font-weight: bold;">Contact</a>

                @{
                    // Get the current relative URL to check which page we are on
                    var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
                    var isAuthPage = relativeUri.Contains("login") || relativeUri.Contains("register");
                }

                @if (!isAuthPage)
                {
                    <AuthorizeView>
                        <Authorized>
                            @* This block shows ONLY when the user IS logged in *@
                            <a href="Account/Manage"
                               style="background-color: black; color: white; border-radius: 10px; padding: 10px 25px; border: none; cursor: pointer; font-weight: bold; margin-left: 20px; text-decoration: none;">
                                User
                            </a>
                            <form action="Account/Logout" method="post" style="display: inline;">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit"
                                        style="background-color: darkred; color: white; border-radius: 10px; padding: 10px 25px; border: none; cursor: pointer; font-weight: bold; margin-left: 10px;">
                                    Logout
                                </button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            @* This block shows ONLY when the user is NOT logged in *@
                            <a href="Account/Login"
                               style="background-color: black; color: white; border-radius: 10px; padding: 10px 25px; border: none; cursor: pointer; font-weight: bold; margin-left: 20px; text-decoration: none;">
                                Login
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                }
            </div>
        </div>

        @* The Content Area *@
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>