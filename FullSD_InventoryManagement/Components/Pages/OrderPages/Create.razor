@page "/orders/create"
@rendermode InteractiveServer
@using FullSD_InventoryManagement.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FullSD_InventoryManagement.Domain
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<FullSD_InventoryManagementContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<FullSD_InventoryManagementUser> UserManager

<PageTitle>Create Order</PageTitle>

<style>
    .dashboard-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 20px;
        background-color: #f9f9f9;
        min-height: calc(100vh - 70px);
    }

    .order-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 1100px;
        border: 1px solid #e0e0e0;
    }

    .form-header {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 15px;
        margin-top: 20px;
        border-bottom: 2px solid #eee;
        padding-bottom: 10px;
    }

    .btn-black {
        background-color: black;
        color: white;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        padding: 10px 20px;
    }

    .add-item-box {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        border: 1px solid #e9ecef;
    }

    .action-link {
        font-size: 0.8rem;
        cursor: pointer;
        text-decoration: underline;
        color: blue;
        margin-left: 5px;
    }
</style>

<div class="dashboard-container">
    <div class="order-card">
        <h1 class="form-header">Create New Order</h1>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        <EditForm Model="Order" OnValidSubmit="AddOrder" FormName="create">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="row">
                @* --- LEFT COLUMN: Order Info --- *@
                <div class="col-md-5">
                    <h3 class="section-title">Order Information</h3>

                    <div class="mb-3">
                        <label class="form-label"><strong>Branch:</strong></label>
                        @if (isAdmin)
                        {
                            @* Admin can select any branch *@
                            <InputSelect @bind-Value="Order.BranchID" class="form-control">
                                <option value="0">-- Select Branch --</option>
                                @foreach (var branch in AllBranches)
                                {
                                    <option value="@branch.Id">@branch.Name</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            @* User is locked to their assigned branch *@
                            <input type="text" class="form-control" value="@branchName" disabled />
                            <small class="text-muted">Orders are assigned to your registered branch.</small>
                        }
                        <ValidationMessage For="() => Order.BranchID" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="movement" class="form-label">Movement Type:</label>
                        <InputSelect id="movement" @bind-Value="Order.Movement" class="form-control">
                            @foreach (var movement in Enum.GetValues(typeof(MovementType)))
                            {
                                <option value="@movement">@movement</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                @* --- RIGHT COLUMN: Add Items --- *@
                <div class="col-md-7">
                    <h3 class="section-title">Order Items</h3>

                    <div class="add-item-box">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-6">

                                @* --- TOGGLE: Select Existing OR Create New --- *@
                                @if (isCreatingNewItem)
                                {
                                    <label class="form-label">New Item Name</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="newItemName" placeholder="Enter name..." />
                                        <button type="button" class="btn btn-success" @onclick="SaveNewItem">Save</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => isCreatingNewItem = false">X</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-between">
                                        <label class="form-label">Select Item</label>
                                        <span class="action-link" @onclick="() => isCreatingNewItem = true">+ New Item</span>
                                    </div>
                                    <select class="form-control" @bind="selectedItemId">
                                        <option value="0">-- Choose Item --</option>
                                        @foreach (var item in AvailableItems)
                                        {
                                            <option value="@item.Id">@item.Name</option>
                                        }
                                    </select>
                                }

                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Qty</label>
                                <input type="number" class="form-control" @bind="selectedQty" min="1" />
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-secondary w-100" @onclick="AddItemToOrder" disabled="@isCreatingNewItem">Add</button>
                            </div>
                        </div>
                    </div>

                    @* --- ITEMS TABLE --- *@
                    @if (Order.OrderDetails.Any())
                    {
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Item Name</th>
                                    <th style="width: 80px;">Qty</th>
                                    <th style="width: 100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Order.OrderDetails)
                                {
                                    <tr>
                                        <td>@GetItemName(detail.ItemID)</td>
                                        <td>@detail.Quantity</td>
                                        <td>
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => RemoveItem(detail)">
                                                Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center p-4 text-muted border rounded" style="border-style: dashed !important;">
                            No items added to this order yet.
                        </div>
                    }
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between">
                <a href="/orders" class="btn btn-outline-dark">Cancel</a>
                <button type="submit" class="btn btn-black">Submit Order</button>
            </div>

        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Order Order { get; set; } = new();

    private string? ErrorMessage;

    // UI State
    private bool isAdmin = false;
    private string branchName = "Loading...";
    private List<Item> AvailableItems = new();
    private List<Branch> AllBranches = new();

    // Inputs for Add Item
    private int selectedItemId;
    private int selectedQty = 1;

    // --- MISSING VARIABLES FIXED HERE ---
    private bool isCreatingNewItem = false;
    private string newItemName = "";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        // 1. Load Items
        AvailableItems = await context.Item.ToListAsync();

        // 2. Identify User
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;
        var userName = userPrincipal.Identity?.Name ?? "System";

        isAdmin = userPrincipal.IsInRole("Administrator");

        if (isAdmin)
        {
            AllBranches = await context.Branch.ToListAsync();
        }
        else
        {
            var domainUser = await context.User
                .FirstOrDefaultAsync(u => u.EmailAddress == userName || u.Username == userName);

            if (domainUser != null)
            {
                Order.BranchID = domainUser.BranchID;
                var branch = await context.Branch.FindAsync(domainUser.BranchID);
                branchName = branch?.Name ?? "Unknown";
                Order.Location = branchName;
            }
            else
            {
                branchName = "No Branch Assigned";
            }
        }

        // 3. Set Audit Fields
        Order.CreatedBy = userName;
        Order.UpdatedBy = userName;
        Order.DateCreated = DateTime.Now;
        Order.DateUpdated = DateTime.Now;
    }

    // --- FUNCTION TO SAVE NEW ITEM ---
    private async Task SaveNewItem()
    {
        if (string.IsNullOrWhiteSpace(newItemName)) return;

        using var context = DbFactory.CreateDbContext();

        // Check duplicates
        bool exists = await context.Item.AnyAsync(i => i.Name.ToLower() == newItemName.ToLower());
        if (exists)
        {
            var existingItem = await context.Item.FirstAsync(i => i.Name.ToLower() == newItemName.ToLower());
            selectedItemId = existingItem.Id;
        }
        else
        {
            var newItem = new Item
            {
                Name = newItemName,
                CreatedBy = Order.CreatedBy,
                UpdatedBy = Order.UpdatedBy,
                DateCreated = DateTime.Now,
                DateUpdated = DateTime.Now
            };

            context.Item.Add(newItem);
            await context.SaveChangesAsync();

            // Refresh list and select new item
            AvailableItems = await context.Item.ToListAsync();
            selectedItemId = newItem.Id;
        }

        // Reset UI
        newItemName = "";
        isCreatingNewItem = false;
    }

    private void AddItemToOrder()
    {
        if (selectedItemId == 0) return;
        if (selectedQty <= 0) return;

        var existing = Order.OrderDetails.FirstOrDefault(od => od.ItemID == selectedItemId);
        if (existing != null)
        {
            existing.Quantity += selectedQty;
        }
        else
        {
            Order.OrderDetails.Add(new OrderDetail
            {
                ItemID = selectedItemId,
                Quantity = selectedQty,
                CreatedBy = Order.CreatedBy,
                UpdatedBy = Order.UpdatedBy,
                DateCreated = DateTime.Now,
                DateUpdated = DateTime.Now
            });
        }

        selectedItemId = 0;
        selectedQty = 1;
    }

    private void RemoveItem(OrderDetail detail)
    {
        Order.OrderDetails.Remove(detail);
    }

    private string GetItemName(int itemId)
    {
        return AvailableItems.FirstOrDefault(i => i.Id == itemId)?.Name ?? "Unknown ID";
    }

    private async Task AddOrder()
    {
        using var context = DbFactory.CreateDbContext();
        ErrorMessage = null;

        if (Order.BranchID == 0)
        {
            ErrorMessage = "Please select a branch.";
            return;
        }

        if (string.IsNullOrEmpty(Order.Location))
        {
            var selectedBranch = await context.Branch.FindAsync(Order.BranchID);
            Order.Location = selectedBranch?.Name ?? "Unknown";
        }

        if (!Order.OrderDetails.Any())
        {
            ErrorMessage = "Please add at least one item to the order.";
            return;
        }

        if (Order.Movement == MovementType.Out)
        {
            foreach (var detail in Order.OrderDetails)
            {
                var stock = await context.BranchInventory
                    .FirstOrDefaultAsync(b => b.BranchID == Order.BranchID && b.ItemID == detail.ItemID);

                int currentStock = stock?.Quantity ?? 0;

                var pendingQuantity = await context.OrderDetail
                    .Include(od => od.Order)
                    .Where(od => od.ItemID == detail.ItemID
                                 && od.Order.BranchID == Order.BranchID
                                 && od.Order.Status == OrderStatus.Pending
                                 && od.Order.Movement == MovementType.Out)
                    .SumAsync(od => od.Quantity);

                if ((currentStock - pendingQuantity) < detail.Quantity)
                {
                    ErrorMessage = $"Insufficient stock for {GetItemName(detail.ItemID)}. Available: {currentStock - pendingQuantity}";
                    return;
                }
            }
        }

        if (isAdmin)
        {
            Order.Status = OrderStatus.Approved;
            await ProcessInventoryMovement(context, Order);
        }
        else
        {
            Order.Status = OrderStatus.Pending;
        }

        context.Order.Add(Order);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/orders");
    }

    private async Task ProcessInventoryMovement(FullSD_InventoryManagementContext context, Order order)
    {
        foreach (var detail in order.OrderDetails)
        {
            var inventory = await context.BranchInventory
                .FirstOrDefaultAsync(bi => bi.BranchID == order.BranchID && bi.ItemID == detail.ItemID);

            if (inventory == null)
            {
                inventory = new BranchInventory
                {
                    BranchID = order.BranchID,
                    ItemID = detail.ItemID,
                    Quantity = 0,
                    CreatedBy = order.CreatedBy,
                    UpdatedBy = order.UpdatedBy,
                    DateCreated = DateTime.Now,
                    DateUpdated = DateTime.Now
                };
                context.BranchInventory.Add(inventory);
            }

            if (order.Movement == MovementType.In)
            {
                inventory.Quantity += detail.Quantity;
            }
            else if (order.Movement == MovementType.Out)
            {
                inventory.Quantity -= detail.Quantity;
            }

            inventory.DateUpdated = DateTime.Now;
            inventory.UpdatedBy = order.UpdatedBy;
        }
    }
}